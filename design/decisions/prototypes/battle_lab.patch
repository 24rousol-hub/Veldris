diff --git a/data/scripts/veldris_debug.inc b/data/scripts/veldris_debug.inc
index 5dda0dfe..6f947780 100644
--- a/data/scripts/veldris_debug.inc
+++ b/data/scripts/veldris_debug.inc
@@ -356,3 +356,84 @@ Veldris_Debug_Text_AllBadges:
 Veldris_Debug_Text_FieldMoves:
 	.string "All nine badges set. SWAMPERT and\n"
 	.string "TROPIUS added: they can learn them all.$"
+
+@ ---------------------------------------------------------------------------------------------------------
+@ LAB (decisions-battle experiment, clone only, never merged)
+@ ---------------------------------------------------------------------------------------------------------
+Veldris_Lab_Team50::
+	callnative ZeroPlayerPartyMons
+	setflag FLAG_SYS_EXP_SHARE_ON
+	setvar VAR_0x8004, 50
+	call Veldris_Debug_GiveTeam
+	return
+
+Veldris_Lab_Dim::
+	callnative ZeroPlayerPartyMons
+	setvar VAR_0x8004, 20
+	call Veldris_Debug_GiveTeam
+	trainerbattle_no_intro TRAINER_HACHIMEL, Veldris_Lab_Text_Defeat
+	releaseall
+	end
+
+Veldris_Lab_Basic::
+	call Veldris_Lab_Team50
+	trainerbattle_no_intro TRAINER_WALLY_VR_3, Veldris_Lab_Text_Defeat
+	releaseall
+	end
+
+Veldris_Lab_Smart::
+	call Veldris_Lab_Team50
+	trainerbattle_no_intro TRAINER_WALLY_VR_4, Veldris_Lab_Text_Defeat
+	releaseall
+	end
+
+Veldris_Lab_Smartest::
+	call Veldris_Lab_Team50
+	trainerbattle_no_intro TRAINER_WALLY_VR_5, Veldris_Lab_Text_Defeat
+	releaseall
+	end
+
+@ Badges cleared (cap 12), Mudkip AT the cap, a level-5 Zigzagoon on the bench (Exp. Share on), DALE's lead gets +1 Atk +1 SpAtk.
+Veldris_Lab_CapBoost::
+	callnative ZeroPlayerPartyMons
+	call Veldris_Debug_ClearBadges
+	setflag FLAG_SYS_EXP_SHARE_ON
+	givemon SPECIES_MUDKIP, 12
+	givemon SPECIES_ZIGZAGOON, 5
+	special HealPlayerParty
+	settotemboost B_POSITION_OPPONENT_LEFT, 1, 0, 0, 1
+	trainerbattle_no_intro TRAINER_CRESTFALL_GYM_1, Veldris_Lab_Text_Defeat
+	releaseall
+	end
+
+@ A boost is queued, then a WILD battle starts instead (what a skipped trainer fight would leave behind).
+Veldris_Lab_Stale::
+	callnative ZeroPlayerPartyMons
+	givemon SPECIES_MUDKIP, 12
+	settotemboost B_POSITION_OPPONENT_LEFT, 2, 0, 0, 0
+	setwildbattle SPECIES_ZIGZAGOON, 3
+	dowildbattle
+	releaseall
+	end
+
+@ Tag battle: the player and PARTNER_TROGLODYTE against one trainer (DALE).
+Veldris_Lab_Tag::
+	callnative ZeroPlayerPartyMons
+	setvar VAR_0x8004, 40
+	call Veldris_Debug_GiveTeam
+	multi_2_vs_1 TRAINER_CRESTFALL_GYM_1, Veldris_Lab_Text_Defeat, PARTNER_TROGLODYTE
+	releaseall
+	end
+
+@ Two opponents at once (DALE and WREN), the player's own two lead Pokemon.
+Veldris_Lab_Two::
+	callnative ZeroPlayerPartyMons
+	setvar VAR_0x8004, 40
+	call Veldris_Debug_GiveTeam
+	@ raw form of trainerbattle_two_trainers with facePlayer FALSE, continueScript TRUE, skipFlagCheck TRUE (callable without an NPC)
+	trainerbattle LOCALID_NONE, TRAINER_CRESTFALL_GYM_1, NULL, Veldris_Lab_Text_Defeat, NULL, LOCALID_NONE, TRAINER_CRESTFALL_GYM_2, NULL, Veldris_Lab_Text_Defeat, NULL, NULL, NULL, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE
+	releaseall
+	end
+
+Veldris_Lab_Text_Defeat:
+	.string "Beaten.$"
