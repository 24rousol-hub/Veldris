diff --git a/src/veldris_skip.c b/src/veldris_skip.c
new file mode 100644
index 00000000..def16923
--- /dev/null
+++ b/src/veldris_skip.c
@@ -0,0 +1,29 @@
+#include "global.h"
+#include "main.h"
+#include "veldris_skip.h"
+
+#define VELDRIS_SKIP_BUTTON      R_BUTTON
+#define VELDRIS_SKIP_PAGE_FRAMES 8 // a page stays up at least this long while skipping, so it is still seen
+
+// TRUE while the skip button is down.
+bool32 VeldrisSkipHeld(void)
+{
+    return JOY_HELD(VELDRIS_SKIP_BUTTON) != 0;
+}
+
+// TRUE once every VELDRIS_SKIP_PAGE_FRAMES calls while the skip button is held. The callers (the text printer's wait
+// for a button, the script command waitbuttonpress) run once per frame while they wait.
+bool32 VeldrisSkipPagePulse(void)
+{
+    static u8 sFrames;
+
+    if (!JOY_HELD(VELDRIS_SKIP_BUTTON))
+    {
+        sFrames = 0;
+        return FALSE;
+    }
+    if (++sFrames < VELDRIS_SKIP_PAGE_FRAMES)
+        return FALSE;
+    sFrames = 0;
+    return TRUE;
+}
